<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="14dp"
    android:background="@drawable/widget_panel">

    <TextClock
        android:id="@+id/dotTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="hh:mm"
        android:format24Hour="HH:mm"
        android:textColor="@color/resflix_text"
        android:textSize="38sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:letterSpacing="0.04" />

    <TextView
        android:id="@+id/dotDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WED, 18 NOV"
        android:textColor="@color/resflix_muted"
        android:textSize="10sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DOT MATRIX / RED"
        android:textColor="@color/resflix_red"
        android:textSize="9sp"
        android:layout_marginTop="8dp" />

</LinearLayout>
